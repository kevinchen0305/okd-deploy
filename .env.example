# okd-deploy .env template — copy to .env and fill in.
#
#   cp .env.example .env
#   chmod 600 .env
#   $EDITOR .env
#
# Then `source .env` before running any scripts that touch AWS.
# .env itself is gitignored; .env.example is the only one tracked.

# ──────────────────────────────────────────────────────────
# Cluster-wide settings (same across every cluster in this account)
# ──────────────────────────────────────────────────────────

# Route53 hosted zone you own. OKD installer creates
# api.<cluster>.$BASE_DOMAIN and *.apps.<cluster>.$BASE_DOMAIN under it.
export BASE_DOMAIN="awesome-okd.example.com"

# RHCOS AMI for $REGION. Find via:
#   openshift-install coreos print-stream-json | jq -r '.architectures.x86_64.images.aws.regions."<REGION>".image'
export AMI_ID="ami-XXXXXXXXXXXXXXXXX"

export REGION="ap-northeast-1"

# Lab-only: single-AZ deployment. Pick any AZ within $REGION.
export AZ="ap-northeast-1c"

# VPC CIDR. Must not collide with OKD pod (10.128.0.0/14) or service
# (172.30.0.0/16) networks. 10.0.0.0/16 is the safe default.
export VPC_CIDR="10.0.0.0/16"

# ──────────────────────────────────────────────────────────
# Secrets — keep the SOURCE files out of the repo, .env references them
# ──────────────────────────────────────────────────────────

# Path to your SSH public key. Gets embedded in RHCOS ignition so you can
# `ssh core@<node>` for debugging. Lab-only key recommended:
#   ssh-keygen -t ed25519 -f ~/.ssh/id_okd -N "" -C "okd-lab"
export SSH_KEY="$HOME/.ssh/id_okd.pub"

# OKD pull secret JSON content (NOT a path — envsubst inlines the value).
# Download from https://console.redhat.com/openshift/install/pull-secret
# and save to ~/.okd-pull-secret.json (chmod 600); this expands its
# content at source time.
export PULL_SECRET="$(cat $HOME/.okd-pull-secret.json)"

# ──────────────────────────────────────────────────────────
# Cluster sizing — no defaults, must be explicit (lab cost control)
# ──────────────────────────────────────────────────────────
# Hourly cost (m5 family in ap-northeast-1, approx):
#   m5.large   2 vCPU /  8 GB / $0.124/hr
#   m5.xlarge  4 vCPU / 16 GB / $0.248/hr
#   m5.2xlarge 8 vCPU / 32 GB / $0.496/hr
#   m5.4xlarge 16 vCPU / 64 GB / $0.992/hr
#
# Default below: 1× m5.2xlarge master + 2× m5.4xlarge worker ≈ $2.48/hr.
# Lab-light: m5.xlarge master + 2× m5.xlarge worker ≈ $0.74/hr.

export MASTER_INSTANCE_TYPE="m5.2xlarge"   # lab=m5.2xlarge, HA prod=m5.4xlarge+
export WORKER_INSTANCE_TYPE="m5.4xlarge"   # lab-light=m5.xlarge
export MASTER_REPLICAS=1                   # lab=1, prod=3 (must be odd for etcd quorum)
export WORKER_REPLICAS=2

# ──────────────────────────────────────────────────────────
# Optional overrides (uncomment + edit if needed)
# ──────────────────────────────────────────────────────────
# export ARCH="amd64"             # default amd64
# export OWNER_TAG="lab_kevin"    # AWS resource userTags.owner
# export PURPOSE_TAG="cafe_okd"   # AWS resource userTags.purpose
